# Server Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# Database Configuration (Docker MySQL)
DATABASE_URL="mysql://root:root@localhost:3307/sikd_db"

# JWT Configuration
JWT_SECRET=sikd-super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=7d
