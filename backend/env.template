# ============================================
# ENVIRONMENT VARIABLES - SISTEM INFORMASI KEPENDUDUKAN DESA
# ============================================
# 
# Copy file ini menjadi .env (rename env.template menjadi .env)
# JANGAN commit file .env ke git (sudah ada di .gitignore)
#
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL dengan Laragon)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Default Laragon: user=root, password=kosong, port=3306
DATABASE_URL="mysql://root:@localhost:3306/sikd_db"

# JWT Configuration
# WAJIB diubah di production dengan string random yang kuat!
# Generate random string: openssl rand -base64 32
JWT_SECRET=sikd-super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# ============================================
# CATATAN PENTING:
# ============================================
# 1. Pastikan database "sikd_db" sudah dibuat di Laragon MySQL
# 2. Jika password MySQL tidak kosong, ubah DATABASE_URL:
#    DATABASE_URL="mysql://root:PASSWORD@localhost:3306/sikd_db"
# 3. JWT_SECRET harus kuat di production!
# 4. FRONTEND_URL sesuaikan dengan port frontend React
# ============================================

